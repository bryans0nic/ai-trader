# Alpaca paper trading credentials.
# Get free paper trading keys at https://app.alpaca.markets/paper/dashboard/overview
# Copy this file to .env and fill in your own values. Never commit .env.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# Phone push alerts via ntfy.sh (free, no account). Pick a long random topic name,
